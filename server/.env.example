# Port the HTTP server listens on
PORT=3000

# Cache TTL in seconds — how long aggregated results are kept before re-fetching upstream feeds
CACHE_TTL_SECONDS=300

# Per-source fetch timeout in milliseconds — sources that don't respond within this window are treated as failed
FETCH_TIMEOUT_MS=5000

# Comma-separated list of RSS/Atom feed URLs to aggregate
# If unset, the compiled DEFAULT_FEEDS list in src/config.ts is used
FEED_URLS=https://openai.com/blog/rss.xml,https://www.anthropic.com/rss.xml
